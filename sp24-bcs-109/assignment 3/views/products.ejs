<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Allbirds Products</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family: 'Baguet Script';
    font-style: italic;
    background-color: rgb(221, 221, 221);
}

/* HEADER */

.page-title{
    text-align:center;
    margin-top:40px;
}

.page-title h1{
    font-size:40px;
    margin-bottom:10px;
}

.page-title p{
    color:#666;
    margin-bottom:40px;
}

/* FILTER BAR */

.filter-bar{
    width:90%;
    margin:auto;
    margin-bottom:40px;
    display:flex;
    gap:15px;
    flex-wrap:wrap;
    justify-content:center;
}

.filter-bar input,
.filter-bar select{
    padding:12px;
    border:1px solid #ddd;
    min-width:180px;
    border-radius: 20px;
    font-family: 'Baguet Script';
}

.filter-bar button{
    padding:12px 25px;
    background:black;
    color:white;
    border:none;
    cursor:pointer;
    border-radius: 20px;
}

/* PRODUCTS GRID */

.products{
    width:90%;
    margin:auto;

    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
}

/* CARD */

.card{
    background:white;
    transition:0.3s;
    border-radius: 20px;
}

.card:hover{
    transform:translateY(-5px);
}

.card img{
    width:100%;
    height:350px;
    object-fit:cover;
    background:#f5f5f5;
    border-radius: 20px;
}

.card-content{
    padding:15px;
}

.card h3{
    font-size:20px;
    margin-bottom:8px;
}

.category{
    color:#777;
    margin-bottom:10px;
}

.price{
    font-size:18px;
    font-weight:bold;
}

/* PAGINATION */

.pagination{
    text-align:center;
    margin:50px 0;
}

.pagination a{
    text-decoration:none;
    color:black;

    padding:10px 15px;
    border:1px solid #ddd;
    margin:5px;
}

.active-page{
    background:black;
    color:white !important;
}

/* MOBILE */

@media(max-width:900px){

    .products{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:600px){

    .products{
        grid-template-columns:1fr;
    }

}

</style>
</head>

<body>

<div class="page-title">

    <h1>Allbirds Collection</h1>

    <p>
        Lightweight, comfortable and sustainable products
    </p>

</div>

<form method="GET" action="/products" class="filter-bar">

    <input
        type="text"
        name="search"
        placeholder="Search Products"
        value="<%= search %>"
    >

    <select name="category">

        <option value="">All Categories</option>

        <option value="Men"
            <%= category === "Men" ? "selected" : "" %>>
            Men
        </option>

        <option value="Women"
            <%= category === "Women" ? "selected" : "" %>>
            Women
        </option>

        <option value="Apparel"
            <%= category === "Apparel" ? "selected" : "" %>>
            Apparel
        </option>

        <option value="Accessories"
            <%= category === "Accessories" ? "selected" : "" %>>
            Accessories
        </option>

    </select>

    <input
        type="number"
        name="minPrice"
        placeholder="Min Price"
        value="<%= minPrice %>"
    >

    <input
        type="number"
        name="maxPrice"
        placeholder="Max Price"
        value="<%= maxPrice %>"
    >

    <button type="submit">
        Apply Filters
    </button>

</form>

<div class="products">

<% products.forEach(product => { %>

    <div class="card">

        <img
            src="<%= product.image || '/public/images/no-image.jpg' %>"
            alt="<%= product.name %>"
        >

        <div class="card-content">

            <h3>
                <%= product.name %>
            </h3>

            <p class="category">
                <%= product.category %>
            </p>

            <p class="price">
                $<%= product.price %>
            </p>

        </div>

    </div>

<% }) %>

</div>

<div class="pagination">

<% if(currentPage > 1){ %>

<a href="/products?page=<%= currentPage - 1 %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">
Previous
</a>

<% } %>

<% for(let i=1;i<=totalPages;i++){ %>

<a
class="<%= currentPage === i ? 'active-page' : '' %>"
href="/products?page=<%= i %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>"
>
<%= i %>
</a>

<% } %>

<% if(currentPage < totalPages){ %>

<a href="/products?page=<%= currentPage + 1 %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">
Next
</a>

<% } %>

</div>

</body>
</html>